{
  "security_group": {
    "name": "root-www",
    "rules": [
      "80 tcp 0.0.0.0/0",
      "443 tcp 0.0.0.0/0",
      "65100 tcp 0.0.0.0/0"
    ]
  },

  "servers": [
    {
      "hostname": "nitrous.io",
      "elb": true,
      "region": "us-east-1",
      "size": "m1.small",
      "ami": "ami-deadbeef"
    },
    {
      "hostname": "sensu-usw1.nitrous.io",
      "size": "m1.small",
      "region": "us-west-1",
      "ami": "ami-deadbeef",
      "block_devices": [
        {
          "name": "/dev/sdf",
          "snapshot_id": "snap-deadbeef",
          "size": 20,
          "delete_on_termination": "false"
        },
        {
          "name": "/dev/sdg",
          "snapshot_id": "snap-deadbeef",
          "size": 40,
          "delete_on_termination": "false"
        }
      ]
    },
    {
      "hostname": "sensu-usw2.nitrous.io",
      "size": "m1.large",
      "region": "us-west-1",
      "ami": "ami-deadbeef",
      "block_devices": [
        {
          "name": "/dev/sdf",
          "snapshot_id": "snap-cafedead",
          "size": 20,
          "delete_on_termination": "false"
        }
      ]
    }
  ]
}
